# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Zerion ──────────────────────────────────────────────────
# Get a read key at https://developers.zerion.io — used for polling/analysis.
ZERION_API_KEY=zpk_...

# ── Custody master secret ────────────────────────────────────
# 32+ bytes of randomness — encrypts each user's private key at rest.
# Generate once with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change this after users have funded wallets — you'll lose access to their keys.
MASTER_SECRET=replace_me_with_64_hex_chars

# Optional: custom RPC URLs (fallback is viem's public RPC per chain).
# RPC_ETHEREUM=https://...
# RPC_BASE=https://...

# ── Scoped policies (defaults — overridable per-user via /settings) ──
MAX_MIRROR_USD=50
ALLOWED_CHAINS=ethereum,base
MAX_SLIPPAGE=0.5
DAILY_SPEND_LIMIT=200
MIRROR_COOLDOWN_MINUTES=30

# ── Operational ────────────────────────────────────────────
POLL_INTERVAL_MINUTES=5
# Comma-separated Telegram user IDs. Leave empty for open bot.
ADMIN_USER_IDS=

# SQLite path (relative to repo root).
DB_PATH=./data/parasocial.db

# Optional: override the path to the Zerion CLI binary.
# Defaults to `npx --yes zerion-cli@latest`.
# ZERION_CLI_BIN=zerion
